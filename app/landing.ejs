<div id="landingContainer" style="display: none;">
    <!-- 호타이쿤 메인: 위(로고·계정) · 가운데(공지 쪽지 + 서버 판) · 아래 띠(서버 고르기 + 게임 시작) -->
    <div class="hoty-top">
        <div class="hoty-brand">
            <div class="hoty-en">HOBAEK'S TYCOON</div>
            <div class="hoty-logo">호타이쿤</div>
        </div>
        <div id="image_seal_container">
            <span class="hoty-upd-badge"><i class="spr" data-s="upd"></i>업데이트</span>
            <div id="updateAvailableTooltip"><%- lang('landing.updateAvailableTooltip') %></div>
        </div>
        <div id="user_content" class="hoty-acct">
            <div id="avatarContainer"></div>
            <span id="user_text"><%- lang('landing.usernamePlaceholder') %></span>
            <button id="avatarOverlay" title="<%- lang('landing.usernameEditButton') %>"></button>
        </div>
        <div id="settingsMediaContainer">
            <button id="settingsMediaButton" class="hoty-iconbtn" title="<%- lang('landing.settingsTooltip') %>">
                <i class="spr" data-s="gear"></i>
                <div id="settingsTooltip"><%- lang('landing.settingsTooltip') %></div>
            </button>
        </div>
    </div>

    <div class="hoty-mid">
        <div class="hoty-frame hoty-paper hoty-news">
            <div class="hoty-title"><div class="hoty-title-en">NOTICE</div><div class="hoty-title-ko">공지</div></div>
            <div id="hotyNotice">
                <div class="hoty-post empty"><span class="hoty-b">공지를 불러오는 중…</span></div>
            </div>
        </div>
        <div class="hoty-frame hoty-card">
            <div class="hoty-cap">SERVER</div>
            <div class="hoty-srv">
                <span class="hoty-seal"><i class="spr" data-s="home"></i></span>
                <div>
                    <div class="hoty-srv-name" id="hotyServerName">호타이쿤</div>
                    <div class="hoty-live off" id="hotyLive"><i></i><span>확인 중</span></div>
                </div>
            </div>
            <div id="server_status_wrapper">
                <div class="hoty-kv"><span id="landingPlayerLabel"><%- lang('landing.serverStatus') %></span><b id="player_count"><%- lang('landing.serverStatusPlaceholder') %></b></div>
            </div>
            <div class="hoty-kv"><span>모드</span><b class="mint" id="hotyModCount">-</b></div>
            <span class="hoty-sp"></span>
            <div class="hoty-modrow">
                <span class="hoty-mini"><i class="spr gold" data-s="pack"></i></span>
                <span class="hoty-mini"><i class="spr event" data-s="horn"></i></span>
                <span class="hoty-mini"><i class="spr" data-s="map"></i></span>
                <span class="hoty-mini"><i class="spr gold" data-s="spark"></i></span>
                <span class="hoty-mini"><i class="spr" data-s="book"></i></span>
            </div>
        </div>
    </div>

    <div class="hoty-bot">
        <div class="hoty-info">
            <b>런처 <span id="hotyLauncherVersion"></span></b> · 마인크래프트 <span id="hotyMcVersion">-</span><br>
            바뀐 모드는 시작할 때 자동으로 받아요
        </div>
        <div id="launch_content">
            <button id="server_selection_button" class="hoty-btn hoty-btn-board"><%- lang('landing.launchButtonPlaceholder') %></button>
            <button id="launch_button" class="hoty-btn hoty-btn-gold hoty-btn-lg"><%- lang('landing.launchButton') %></button>
        </div>
        <div id="launch_details">
            <div id="launch_details_right">
                <div class="hoty-prog-label">
                    <span id="launch_details_text"><%- lang('landing.launchDetails') %></span>
                    <span id="launch_details_left"><span id="launch_progress_label">0%</span></span>
                </div>
                <progress id="launch_progress" value="22" max="100"></progress>
            </div>
        </div>
    </div>

    <!-- 원본 Helios 요소(스크립트가 찾는 것들) — 화면에는 안 보인다 -->
    <div class="hoty-hidden">
        <div id="mojangStatusWrapper">
            <span id="mojang_status_icon">&#8226;</span>
            <div id="mojangStatusTooltip">
                <div id="mojangStatusEssentialContainer"></div>
                <div id="mojangStatusNEContainer"></div>
                <div id="mojangStatusNonEssentialContainer"></div>
            </div>
        </div>
        <button id="newsButton" tabindex="-1">
            <div id="newsButtonAlert" style="display: none;"></div>
            <span id="newsButtonText"><%- lang('landing.newsButton') %></span>
        </button>
        <div id="newsContainer">
            <div id="newsContent" article="-1" style="display: none;">
                <a id="newsArticleTitle" href="#"></a>
                <span id="newsArticleDate"></span>
                <span id="newsArticleAuthor"></span>
                <a href="#" id="newsArticleComments"></a>
                <button id="newsNavigateLeft"></button>
                <span id="newsNavigationStatus"></span>
                <button id="newsNavigateRight"></button>
                <div id="newsArticleContentScrollable"></div>
            </div>
            <div id="newsErrorContainer">
                <div id="newsErrorLoading"><span id="nELoadSpan" class="newsErrorContent"></span></div>
                <div id="newsErrorFailed" style="display: none;"><span id="nEFailedSpan" class="newsErrorContent"></span><button id="newsErrorRetry"></button></div>
                <div id="newsErrorNone" style="display: none;"><span id="nENoneSpan" class="newsErrorContent"></span></div>
            </div>
        </div>
    </div>
    <script src="./assets/js/scripts/landing.js"></script>
</div>
